  "constraints": [
    {
      "id": "C-001",
      "rule": "An entity's classification may never be lower than the classificationFloor of its type.",
      "severity": "ERROR",
      "scope": "write"
    },
    {
      "id": "C-002",
      "rule": "A relation may not cross a classification boundary unless the relation type has mayCrossClassification=true.",
      "severity": "ERROR",
      "scope": "write"
    },
    {
      "id": "C-003",
      "rule": "A TestResult is immutable once written; corrections are new events with a supersedesRef, never in-place edits.",
      "severity": "ERROR",
      "scope": "write"
    },
    {
      "id": "C-004",
      "rule": "A Model used in a safety-relevant prediction must have approvedForUse=true and a non-null fidelity score.",
      "severity": "ERROR",
      "scope": "use"
    },
    {
      "id": "C-005",
      "rule": "A Credential's personId must resolve to a Person whose citizenship permits the credentialed activity, and whose clearance is current at issue time.",
      "severity": "ERROR",
      "scope": "write"
    },
    {
      "id": "C-006",
      "rule": "Every Person referenced by a Credential or ProcessRun.operatorId must have a non-expired clearance record at the time of reference.",
      "severity": "ERROR",
      "scope": "write"
    },
    {
      "id": "C-007",
      "rule": "A Part with criticality=CRITICAL and isSingleSource=true must have at least one reconstitutes edge or be flagged as a program risk.",
      "severity": "WARNING",
      "scope": "post"
    },
    {
      "id": "C-008",
      "rule": "An EngagementScenario referencing a ThreatSystem must not be readable by an actor whose clearance is below the scenario's classification.",
      "severity": "ERROR",
      "scope": "read"
    },
    {
      "id": "C-009",
      "rule": "An entity's classification may not be lowered in place; a downgrade creates a new entity in a lower partition with derivedFromClassified=true and a parentRefs link to the original.",
      "severity": "ERROR",
      "scope": "write"
    }
  ]
}
