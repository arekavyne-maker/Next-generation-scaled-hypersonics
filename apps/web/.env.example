# NGSH Control Console — environment overrides (copy to .env.local)

# Force the deterministic mock dataset; no network calls are made when true.
# VITE_USE_MOCK=true

# API surface root.
#   proxy mode (default in dev): "/api" -> resolved per service as "/api/<service>"
#   direct mode:               origin of the API gateway, e.g. "http://localhost:8082"
# VITE_API_BASE=/api

# API mode: "proxy" (default in dev) or "direct".
# VITE_API_MODE=proxy

# Per-service base URL overrides (direct mode). Highest precedence.
# VITE_API_ONTOLOGY=http://localhost:8081
# VITE_API_FABRIC=http://localhost:8082
# VITE_API_POLICY=http://localhost:8083
# VITE_API_AUDIT=http://localhost:8084
# VITE_API_THREAD=http://localhost:8085
# VITE_API_INGEST=http://localhost:8086
