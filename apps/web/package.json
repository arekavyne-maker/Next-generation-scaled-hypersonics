    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
