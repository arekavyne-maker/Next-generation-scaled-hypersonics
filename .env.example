# NGSH local environment.
#
# Copy to .env and adjust. Every value has a working default, so an empty
# .env still produces a runnable local stack.

# --- Identity and tenancy -------------------------------------------------
NGSH_TENANT=ngsh
# Program of record, e.g. NGSH-SHY or NGSH-MAVERICK.
NGSH_PROGRAM=NGSH-SHY

# --- Deployment ------------------------------------------------------------
# One of: local, il5, il6, edge. The stub identity provider is refused
# outside local and edge profiles.
NGSH_DEPLOYMENT_PROFILE=local
NGSH_DEPLOYMENT_ZONE=central

# --- Storage ---------------------------------------------------------------
# sqlite:///./data/ngsh.db for local development.
# postgresql://ngsh:ngsh@postgres:5432/ngsh in a containerised topology.
NGSH_DSN=sqlite:///./data/ngsh.db
NGSH_DB_ECHO=false

# --- Identity provider -----------------------------------------------------
# stub  : development actor, no credential required (local and edge only)
# piv   : PIV/ICAM federation (requires a metadata URL and verification URL)
NGSH_IDENTITY_PROVIDER=stub

# --- Service discovery -----------------------------------------------------
# Leave empty in single-process development mode; the services then share
# the platform database directly. Set these to route over HTTP in a
# multi-process deployment.
NGSH_FABRIC_URL=
NGSH_POLICY_URL=
NGSH_AUDIT_URL=
NGSH_ONTOLOGY_URL=
NGSH_THREAD_URL=
# Pillar A first slice (baselines, interfaces, requirement traceability).
NGSH_ARCHITECTURE_URL=

# --- Ports -----------------------------------------------------------------
NGSH_HOST=0.0.0.0
NGSH_PORT=8080

# --- Telemetry -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ngsh
